# Server
PORT=8787

# SQLite database for reports and blocks. Created automatically.
# SQLITE_PATH=./data/riplika.sqlite

# Reviewed reports older than this are deleted once a day.
# REPORT_RETENTION_DAYS=90

# Enable the moderation dashboard at /moderation.
# Generate a token with: openssl rand -hex 32
# MODERATION_TOKEN=

# Set to 1 only when running behind a trusted reverse proxy.
# TRUST_PROXY=0
# MAX_CONNECTIONS_PER_IP=8

# Optional comma-separated allowlist of WebSocket origins.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.example

# Optional TURN relay for WebRTC. Strongly recommended in production.
# In Docker these are build args compiled into the client: rebuild the image
# after changing them (docker compose up -d --build).
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=riplika
# VITE_TURN_CREDENTIAL=change-me
